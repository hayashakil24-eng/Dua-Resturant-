{
  "name": "@cafe-ali/control-panel",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Cafe Ali Control Panel — runs the local backend in-process (no separate Node/PM2 install), with a first-run setup wizard and a live online/offline status view. See ../docs/04-phase-3-deployment-hardening.md.",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.cafeali.controlpanel",
    "productName": "Cafe Ali Control Panel",
    "files": [
      "electron/**",
      "src/**",
      "assets/**",
      "node_modules/**"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "app-backend/dist"
      },
      {
        "from": "../backend/package.json",
        "to": "app-backend/package.json"
      },
      {
        "from": "../backend/prisma/schema.prisma",
        "to": "app-backend/prisma/schema.prisma"
      },
      {
        "from": "../backend/prisma/migrations",
        "to": "app-backend/prisma/migrations"
      },
      {
        "from": "../backend/prisma/menu-data.json",
        "to": "app-backend/prisma/menu-data.json"
      },
      {
        "from": "../backend/node_modules/.prisma",
        "to": "app-backend/node_modules/.prisma"
      },
      {
        "from": "../backend/node_modules",
        "to": "app-backend/node_modules",
        "filter": [
          "**/*",
          "!.bin/**",
          "!vitest/**",
          "!@vitest/**",
          "!tsx/**",
          "!esbuild/**",
          "!@esbuild/**",
          "!typescript/**",
          "!pm2/**",
          "!@pm2/**",
          "!@types/**",
          "!embedded-postgres/**",
          "!@embedded-postgres/**"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "perMachine": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://169-58-53-109.sslip.io/updates/control-panel",
      "channel": "latest"
    }
  }
}
